# Production env for a VPS host (copy to backend/.env on the server).
# This stack (PostgreSQL + Redis + Celery + gunicorn) is what lets the app
# serve 30-40+ concurrent users without "busy" stalls.

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=generate_a_long_random_string_here
DJANGO_DEBUG=False
# API domain (nginx) or the machine IP if not yet DNS'd.
DJANGO_ALLOWED_HOSTS=api.phagendrababulibrary.in,127.0.0.1
# Frontend origin(s) — the static site on Hostinger/your domain.
DJANGO_CORS_ORIGINS=https://phagendrababulibrary.in,https://www.phagendrababulibrary.in
DJANGO_TRUST_XFF=True
# nginx terminates TLS and sets X-Forwarded-Proto; no Django-level redirect.
DJANGO_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=31536000
FRONTEND_URL=https://phagendrababulibrary.in

# --- PostgreSQL (required — replaces SQLite, the #1 concurrency bottleneck) --
POSTGRES_DB=libseat
POSTGRES_USER=libseat
POSTGRES_PASSWORD=generate_a_strong_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Redis (required — cache, rate limiting and the Celery broker) --------
REDIS_URL=redis://127.0.0.1:6379/0

# --- Email (async via Celery) ----------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=phagendrababulibrary@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL="Phahendra Babu Library <phagendrababulibrary@gmail.com>"

# --- Payments (online Razorpay) --------------------------------------------
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
# From Razorpay Dashboard > Settings > Webhooks (used to verify webhook signatures)
RAZORPAY_WEBHOOK_SECRET=
ALLOW_MOCK_PAYMENTS=False

# --- Optional ----------------------------------------------------------------
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=2
